# pixera-mcp configuration. Copy to .env or set in your MCP client's "env" block.

# Pixera Native API endpoint. In Pixera: Settings -> API -> add a JSON/TCP(dl) port.
PIXERA_HOST=127.0.0.1
PIXERA_PORT=1500

# Per-request timeout in seconds.
PIXERA_TIMEOUT=5.0

# Connect to Pixera on startup. If false (or if the connection fails), the server still
# starts and all offline tools (knowledge, validation, recommendation) work; live tools
# report a clear connection error when used.
PIXERA_AUTOCONNECT=true
